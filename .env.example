# Runtime
NODE_ENV=development
APP_URL=http://localhost:3000
SITE_URL=http://localhost:3000
# Optional explicit canonical origin; SITE_URL is used when this is blank.
NEXT_PUBLIC_SITE_URL=
# Keep indexing disabled until the real HTTPS domain passes the SEO audit.
SEO_INDEXING_ENABLED=false
EVENT_TIME_ZONE=UTC
EVENT_CITY=
# Optional server-side origin for SSR/API calls inside Docker or another private network.
INTERNAL_API_BASE_URL=http://localhost:3000

# PostgreSQL (required for the application runtime)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/destiny_rave?schema=public

# Opaque database-backed admin sessions and CSRF tokens (generate unique values)
SESSION_SECRET=replace-with-at-least-32-random-characters
CSRF_SECRET=replace-with-at-least-32-random-characters

# Redis is required by production readiness checks and rate limiting.
REDIS_URL=redis://localhost:6379

# Storage: local persists under STORAGE_LOCAL_DIR; production may use S3/R2.
MEDIA_DRIVER=local
STORAGE_LOCAL_DIR=./.data/media
MEDIA_PUBLIC_BASE_URL=/assets
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Seed creates the first admin only when both values are present.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# Square is the only payment provider. Keep the access token server-side.
PAYMENT_PROVIDER=square
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=http://localhost:3000/api/v1/webhooks/square
NEXT_PUBLIC_SQUARE_APPLICATION_ID=
NEXT_PUBLIC_SQUARE_LOCATION_ID=
SQUARE_API_VERSION=2026-09-16
CHECKOUT_HOLD_MINUTES=15

# Optional integrations. Missing credentials are reported as not configured,
# never silently replaced with invented content.
BREVO_API_KEY=
MAILCHIMP_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Public frontend/API values. The internal API is the default source.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_DEFAULT_LOCALE=en
