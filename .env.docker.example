NODE_ENV=production
APP_URL=https://your-domain.com
# SITE_URL/NEXT_PUBLIC_SITE_URL should be the same real public origin in production.
SITE_URL=https://your-domain.com
NEXT_PUBLIC_SITE_URL=https://your-domain.com
# Keep false until the real HTTPS domain passes the SEO audit.
SEO_INDEXING_ENABLED=false
EVENT_TIME_ZONE=UTC
EVENT_CITY=
# The app container calls itself on its internal port; keep APP_URL public.
INTERNAL_API_BASE_URL=http://127.0.0.1:3000
APP_HOST_PORT=43171

POSTGRES_DB=destiny_db
POSTGRES_USER=destiny_user
POSTGRES_PASSWORD=CHANGE_TO_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql://destiny_user:CHANGE_TO_LONG_RANDOM_PASSWORD@postgres:5432/destiny_db

REDIS_URL=redis://redis:6379
SESSION_SECRET=CHANGE_TO_RANDOM_64_PLUS_CHARACTERS
CSRF_SECRET=CHANGE_TO_ANOTHER_RANDOM_64_PLUS_CHARACTERS
SESSION_COOKIE_NAME=destiny_admin_session
RUN_DB_MIGRATIONS=true

MEDIA_DRIVER=local
STORAGE_LOCAL_DIR=/app/storage/media
MEDIA_PUBLIC_BASE_URL=/assets

ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

PAYMENT_PROVIDER=square
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=https://your-domain.com/api/v1/webhooks/square
NEXT_PUBLIC_SQUARE_APPLICATION_ID=
NEXT_PUBLIC_SQUARE_LOCATION_ID=
SQUARE_API_VERSION=2026-09-16
CHECKOUT_HOLD_MINUTES=15
BREVO_API_KEY=
MAILCHIMP_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
