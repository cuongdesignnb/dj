generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum ContentStatus {
  DRAFT
  PREVIEW
  PUBLISHED
  ARCHIVED
}

enum LegalStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum DateStatus {
  TBA
  CONFIRMED
}

enum ScheduleStatus {
  TBC
  CONFIRMED
}

enum ArtistStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ArtistSetTimeStatus {
  TBA
  CONFIRMED
}

enum TicketAvailabilityStatus {
  AVAILABLE
  SOLD_OUT
  NOT_AVAILABLE
}

enum BookingStatus {
  RECEIVED
  REVIEWING
  CONTACTED
  CONFIRMED
  DECLINED
  CANCELLED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum StorageDriver {
  LOCAL
  S3
}

enum ProductStockTracking {
  NONE
  TRACKED
}

enum VariantStockStatus {
  IN_STOCK
  OUT_OF_STOCK
  BACKORDER
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum FulfillmentStatus {
  UNFULFILLED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum CheckoutSessionStatus {
  OPEN
  COMPLETE
  EXPIRED
  FAILED
}

enum WebhookStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
}

enum ContactStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

enum SubscriberStatus {
  SUBSCRIBED
  UNSUBSCRIBED
}

enum ProviderSyncStatus {
  PENDING
  SYNCED
  FAILED
}

enum IntegrationStatus {
  CONNECTED
  NOT_CONFIGURED
  ERROR
}

model AdminUser {
  id            String     @id @default(uuid()) @db.Uuid
  email         String     @unique @db.VarChar(320)
  passwordHash  String     @map("password_hash")
  name          String
  status        UserStatus @default(ACTIVE)
  locale        String     @default("en") @db.VarChar(2)
  lastLoginAt   DateTime?  @map("last_login_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  sessions      AdminSession[]
  userRoles     UserRole[]
  auditLogs     AuditLog[]
  uploadedMedia MediaAsset[]
  orderNotes    OrderNote[]

  @@map("admin_users")
}

model AdminSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(128)
  csrfHash   String    @map("csrf_hash") @db.VarChar(128)
  expiresAt  DateTime  @map("expires_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("admin_sessions")
}

model Role {
  id              String           @id @default(uuid()) @db.Uuid
  key             String           @unique @db.VarChar(100)
  name            String
  description     String?
  isSystem        Boolean          @default(false) @map("is_system")
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  key             String           @unique @db.VarChar(160)
  module          String           @db.VarChar(80)
  action          String           @db.VarChar(80)
  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String    @map("user_id") @db.Uuid
  roleId String    @map("role_id") @db.Uuid
  user   AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model AuditLog {
  id          String    @id @default(uuid()) @db.Uuid
  actorUserId String?   @map("actor_user_id") @db.Uuid
  action      String    @db.VarChar(100)
  entityType  String    @map("entity_type") @db.VarChar(100)
  entityId    String?   @map("entity_id") @db.Uuid
  beforeJson  Json?     @map("before_json")
  afterJson   Json?     @map("after_json")
  requestId   String    @map("request_id") @db.VarChar(100)
  createdAt   DateTime  @default(now()) @map("created_at")
  actor       AdminUser? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@map("audit_logs")
}

model MediaAsset {
  id                String          @id @default(uuid()) @db.Uuid
  storageDriver     StorageDriver   @map("storage_driver")
  storageKey        String          @unique @map("storage_key")
  publicUrl         String          @map("public_url")
  mimeType          String          @map("mime_type") @db.VarChar(120)
  sizeBytes         Int             @map("size_bytes")
  width             Int?
  height            Int?
  altText           String          @map("alt_text")
  metadata          Json?
  uploadedBy        String?         @map("uploaded_by") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  deletedAt         DateTime?       @map("deleted_at")
  uploader          AdminUser?      @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)
  contentHeroes     ContentPage[]   @relation("contentHeroMedia")
  contentOgImages   ContentPageTranslation[] @relation("contentOgMedia")
  eventPosters      Event[]         @relation("eventPosterMedia")
  eventHeroes       Event[]         @relation("eventHeroMedia")
  eventOgImages     EventTranslation[] @relation("eventOgMedia")
  artistPortraits   Artist[]        @relation("artistPortraitMedia")
  artistHeroes      Artist[]        @relation("artistHeroMedia")
  artistMedia       ArtistMedia[]
  bottleMedia       BottleOption[]
  newsHeroes        NewsArticle[]   @relation("newsHeroMedia")
  newsCards         NewsArticle[]   @relation("newsCardMedia")
  galleryCovers     GalleryAlbum[]  @relation("galleryCoverMedia")
  galleryHeroes     GalleryAlbum[]  @relation("galleryHeroMedia")
  galleryMedia      GalleryMedia[]
  productImages     ProductImage[]
  partnerLogos      Partner[]       @relation("partnerLogoMedia")
  partnerImages     Partner[]       @relation("partnerImageMedia")

  @@index([createdAt])
  @@map("media_assets")
}

model SiteSetting {
  id         String   @id @default(uuid()) @db.Uuid
  key        String   @unique @db.VarChar(160)
  valueJson  Json     @map("value_json")
  isPublic   Boolean  @default(false) @map("is_public")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

model ContentPage {
  id              String                    @id @default(uuid()) @db.Uuid
  slug            String                    @unique @db.VarChar(80)
  status          ContentStatus             @default(DRAFT)
  heroMediaId     String?                   @map("hero_media_id") @db.Uuid
  publishedAt     DateTime?                 @map("published_at")
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")
  heroMedia       MediaAsset?              @relation("contentHeroMedia", fields: [heroMediaId], references: [id], onDelete: SetNull)
  translations    ContentPageTranslation[]

  @@map("content_pages")
}

model ContentPageTranslation {
  id              String      @id @default(uuid()) @db.Uuid
  pageId          String      @map("page_id") @db.Uuid
  locale          String      @db.VarChar(2)
  title           String
  contentJson     Json        @map("content_json")
  seoTitle        String?     @map("seo_title")
  seoDescription  String?     @map("seo_description")
  ogMediaId       String?     @map("og_media_id") @db.Uuid
  page            ContentPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  ogMedia         MediaAsset? @relation("contentOgMedia", fields: [ogMediaId], references: [id], onDelete: SetNull)

  @@unique([pageId, locale])
  @@map("content_page_translations")
}

model Event {
  id              String                @id @default(uuid()) @db.Uuid
  slug            String                @unique @db.VarChar(120)
  status          ContentStatus         @default(DRAFT)
  lifecycleStatus String                @default("UPCOMING") @map("lifecycle_status") @db.VarChar(40)
  dateStatus      DateStatus            @default(TBA) @map("date_status")
  scheduleStatus  ScheduleStatus        @default(TBC) @map("schedule_status")
  startAt         DateTime?             @map("start_at")
  endAt           DateTime?             @map("end_at")
  venueName       String                @map("venue_name")
  city            String
  region          String?
  country         String
  address         String?
  mapUrl          String?               @map("map_url")
  featured        Boolean               @default(false)
  posterMediaId   String?               @map("poster_media_id") @db.Uuid
  heroMediaId     String?               @map("hero_media_id") @db.Uuid
  publishedAt     DateTime?             @map("published_at")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  deletedAt       DateTime?             @map("deleted_at")
  posterMedia     MediaAsset?           @relation("eventPosterMedia", fields: [posterMediaId], references: [id], onDelete: SetNull)
  heroMedia       MediaAsset?           @relation("eventHeroMedia", fields: [heroMediaId], references: [id], onDelete: SetNull)
  translations    EventTranslation[]
  genres          EventGenre[]
  scheduleItems   EventScheduleItem[]
  ticketTiers     TicketTier[]
  vipPackages     VipPackage[]
  vipBooths       VipBooth[]
  eventArtists    EventArtist[]
  bookingRequests BookingRequest[]
  faqItems        FaqItem[]
  galleryAlbums   GalleryAlbum[]
  newsArticles    NewsArticle[]

  @@index([status, startAt])
  @@index([lifecycleStatus])
  @@map("events")
}

model EventTranslation {
  id              String      @id @default(uuid()) @db.Uuid
  eventId         String      @map("event_id") @db.Uuid
  locale          String      @db.VarChar(2)
  title           String
  eyebrow         String?
  shortDescription String?    @map("short_description")
  description     String?
  seoTitle        String?     @map("seo_title")
  seoDescription  String?     @map("seo_description")
  ogMediaId       String?     @map("og_media_id") @db.Uuid
  event           Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ogMedia         MediaAsset? @relation("eventOgMedia", fields: [ogMediaId], references: [id], onDelete: SetNull)

  @@unique([eventId, locale])
  @@map("event_translations")
}

model EventGenre {
  id        String @id @default(uuid()) @db.Uuid
  eventId   String @map("event_id") @db.Uuid
  genre     String @db.VarChar(80)
  sortOrder Int    @default(0) @map("sort_order")
  event     Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, sortOrder])
  @@map("event_genres")
}

model EventScheduleItem {
  id        String    @id @default(uuid()) @db.Uuid
  eventId   String    @map("event_id") @db.Uuid
  label     String
  startsAt  DateTime? @map("starts_at")
  endsAt    DateTime? @map("ends_at")
  sortOrder Int       @default(0) @map("sort_order")
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, sortOrder])
  @@map("event_schedule_items")
}

model TicketTier {
  id                  String                    @id @default(uuid()) @db.Uuid
  eventId             String                    @map("event_id") @db.Uuid
  name                String
  priceMinor          Int                       @map("price_minor")
  currency            String                    @default("AUD") @db.Char(3)
  badge               String?
  purchasableOnline   Boolean                   @default(false) @map("purchasable_online")
  purchasableAtDoor   Boolean                   @default(false) @map("purchasable_at_door")
  providerName        String?                   @map("provider_name")
  providerExternalId  String?                   @map("provider_external_id")
  providerUrl         String?                   @map("provider_url")
  availabilityStatus  TicketAvailabilityStatus @default(NOT_AVAILABLE) @map("availability_status")
  sortOrder           Int                       @default(0) @map("sort_order")
  enabled             Boolean                   @default(true)
  event               Event                     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, enabled, sortOrder])
  @@map("ticket_tiers")
}

model VipPackage {
  id                  String             @id @default(uuid()) @db.Uuid
  eventId             String             @map("event_id") @db.Uuid
  name                String
  priceMinor          Int                @map("price_minor")
  currency            String             @default("AUD") @db.Char(3)
  capacity            Int
  includedBottleCount Int                @map("included_bottle_count")
  enabled             Boolean            @default(true)
  sortOrder           Int                @default(0) @map("sort_order")
  event               Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  packageBottles      VipPackageBottle[]
  bookingRequests     BookingRequest[]

  @@index([eventId, enabled, sortOrder])
  @@map("vip_packages")
}

model VipBooth {
  id                String          @id @default(uuid()) @db.Uuid
  eventId           String          @map("event_id") @db.Uuid
  code              String
  zone              String?
  x                 Decimal?        @db.Decimal(8, 4)
  y                 Decimal?        @db.Decimal(8, 4)
  requestable       Boolean         @default(true)
  availabilityStatus TicketAvailabilityStatus @default(AVAILABLE) @map("availability_status")
  sortOrder         Int             @default(0) @map("sort_order")
  event             Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  bookingRequests   BookingRequest[]

  @@unique([eventId, code])
  @@map("vip_booths")
}

model BottleOption {
  id             String             @id @default(uuid()) @db.Uuid
  name           String
  mediaId        String?            @map("media_id") @db.Uuid
  enabled        Boolean            @default(true)
  sortOrder      Int                @default(0) @map("sort_order")
  media          MediaAsset?        @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  packageBottles VipPackageBottle[]
  bookingBottles BookingRequestBottle[]

  @@unique([name])
  @@map("bottle_options")
}

model VipPackageBottle {
  vipPackageId   String       @map("vip_package_id") @db.Uuid
  bottleOptionId String       @map("bottle_option_id") @db.Uuid
  vipPackage     VipPackage   @relation(fields: [vipPackageId], references: [id], onDelete: Cascade)
  bottleOption   BottleOption @relation(fields: [bottleOptionId], references: [id], onDelete: Cascade)

  @@id([vipPackageId, bottleOptionId])
  @@map("vip_package_bottles")
}

model BookingRequest {
  id                String                  @id @default(uuid()) @db.Uuid
  eventId           String                  @map("event_id") @db.Uuid
  vipPackageId      String?                 @map("vip_package_id") @db.Uuid
  preferredBoothId  String?                 @map("preferred_booth_id") @db.Uuid
  fullName          String                  @map("full_name")
  email             String                  @db.VarChar(320)
  phone             String?
  groupSize         Int                     @map("group_size")
  specialRequests   String?                 @map("special_requests")
  status            BookingStatus           @default(RECEIVED)
  notificationStatus NotificationStatus     @default(PENDING) @map("notification_status")
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")
  event             Event                   @relation(fields: [eventId], references: [id], onDelete: Restrict)
  vipPackage        VipPackage?             @relation(fields: [vipPackageId], references: [id], onDelete: SetNull)
  preferredBooth    VipBooth?               @relation(fields: [preferredBoothId], references: [id], onDelete: SetNull)
  bottles           BookingRequestBottle[]

  @@index([status, createdAt])
  @@index([email])
  @@map("booking_requests")
}

model BookingRequestBottle {
  bookingRequestId String         @map("booking_request_id") @db.Uuid
  bottleOptionId   String         @map("bottle_option_id") @db.Uuid
  bookingRequest   BookingRequest @relation(fields: [bookingRequestId], references: [id], onDelete: Cascade)
  bottleOption     BottleOption   @relation(fields: [bottleOptionId], references: [id], onDelete: Restrict)

  @@id([bookingRequestId, bottleOptionId])
  @@map("booking_request_bottles")
}

model Artist {
  id              String              @id @default(uuid()) @db.Uuid
  slug            String              @unique @db.VarChar(120)
  country         String              @db.VarChar(80)
  yearLabel       String?             @map("year_label")
  status          ArtistStatus        @default(DRAFT)
  featured        Boolean             @default(false)
  portraitMediaId String?             @map("portrait_media_id") @db.Uuid
  heroMediaId     String?             @map("hero_media_id") @db.Uuid
  setTimeStatus   ArtistSetTimeStatus @default(TBA) @map("set_time_status")
  setTime         DateTime?           @map("set_time")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  deletedAt       DateTime?           @map("deleted_at")
  portraitMedia   MediaAsset?         @relation("artistPortraitMedia", fields: [portraitMediaId], references: [id], onDelete: SetNull)
  heroMedia       MediaAsset?         @relation("artistHeroMedia", fields: [heroMediaId], references: [id], onDelete: SetNull)
  translations    ArtistTranslation[]
  links           ArtistLink[]
  media           ArtistMedia[]
  eventArtists    EventArtist[]

  @@index([status])
  @@map("artists")
}

model ArtistTranslation {
  id              String   @id @default(uuid()) @db.Uuid
  artistId        String   @map("artist_id") @db.Uuid
  locale          String   @db.VarChar(2)
  name            String
  bio             String?
  genresJson      Json?    @map("genres_json")
  seoTitle        String?  @map("seo_title")
  seoDescription  String?  @map("seo_description")
  artist           Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([artistId, locale])
  @@map("artist_translations")
}

model ArtistLink {
  id       String @id @default(uuid()) @db.Uuid
  artistId String @map("artist_id") @db.Uuid
  type     String @db.VarChar(40)
  url      String
  label    String?
  sortOrder Int   @default(0) @map("sort_order")
  artist   Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@index([artistId, sortOrder])
  @@map("artist_links")
}

model ArtistMedia {
  id          String     @id @default(uuid()) @db.Uuid
  artistId    String     @map("artist_id") @db.Uuid
  mediaId     String?    @map("media_id") @db.Uuid
  type        String     @db.VarChar(20)
  externalUrl String?    @map("external_url")
  title       String?
  sortOrder   Int        @default(0) @map("sort_order")
  artist      Artist     @relation(fields: [artistId], references: [id], onDelete: Cascade)
  media       MediaAsset? @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  @@index([artistId, sortOrder])
  @@map("artist_media")
}

model EventArtist {
  eventId      String  @map("event_id") @db.Uuid
  artistId     String  @map("artist_id") @db.Uuid
  sortOrder    Int     @default(0) @map("sort_order")
  billingLabel String? @map("billing_label")
  event        Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  artist       Artist  @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([eventId, artistId])
  @@index([eventId, sortOrder])
  @@map("event_artists")
}

model NewsArticle {
  id             String            @id @default(uuid()) @db.Uuid
  slug           String            @unique @db.VarChar(160)
  category       String            @db.VarChar(80)
  status         ContentStatus     @default(DRAFT)
  featured       Boolean           @default(false)
  heroMediaId    String?           @map("hero_media_id") @db.Uuid
  cardMediaId    String?           @map("card_media_id") @db.Uuid
  relatedEventId String?           @map("related_event_id") @db.Uuid
  publishedAt    DateTime?         @map("published_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  deletedAt      DateTime?         @map("deleted_at")
  heroMedia      MediaAsset?       @relation("newsHeroMedia", fields: [heroMediaId], references: [id], onDelete: SetNull)
  cardMedia      MediaAsset?       @relation("newsCardMedia", fields: [cardMediaId], references: [id], onDelete: SetNull)
  relatedEvent   Event?            @relation(fields: [relatedEventId], references: [id], onDelete: SetNull)
  translations   NewsTranslation[]
  tags           NewsTag[]

  @@index([status, publishedAt])
  @@map("news_articles")
}

model NewsTranslation {
  id                 String      @id @default(uuid()) @db.Uuid
  articleId          String      @map("article_id") @db.Uuid
  locale             String      @db.VarChar(2)
  title              String
  excerpt            String?
  bodyBlocksJson     Json        @map("body_blocks_json")
  quickSummaryJson   Json?       @map("quick_summary_json")
  readingTimeOverride Int?      @map("reading_time_override")
  seoTitle           String?     @map("seo_title")
  seoDescription     String?     @map("seo_description")
  article            NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, locale])
  @@map("news_translations")
}

model Tag {
  id         String    @id @default(uuid()) @db.Uuid
  key        String    @unique @db.VarChar(80)
  label      String
  newsTags   NewsTag[]

  @@map("tags")
}

model NewsTag {
  articleId String      @map("article_id") @db.Uuid
  tagId     String      @map("tag_id") @db.Uuid
  article   NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@map("news_tags")
}

model GalleryAlbum {
  id           String              @id @default(uuid()) @db.Uuid
  slug         String              @unique @db.VarChar(160)
  status       ContentStatus       @default(DRAFT)
  featured     Boolean             @default(false)
  coverMediaId String?             @map("cover_media_id") @db.Uuid
  heroMediaId  String?             @map("hero_media_id") @db.Uuid
  eventId      String?             @map("event_id") @db.Uuid
  venue        String?
  publishedAt  DateTime?           @map("published_at")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  deletedAt    DateTime?           @map("deleted_at")
  coverMedia   MediaAsset?         @relation("galleryCoverMedia", fields: [coverMediaId], references: [id], onDelete: SetNull)
  heroMedia    MediaAsset?         @relation("galleryHeroMedia", fields: [heroMediaId], references: [id], onDelete: SetNull)
  event        Event?              @relation(fields: [eventId], references: [id], onDelete: SetNull)
  translations GalleryTranslation[]
  media        GalleryMedia[]

  @@index([status, publishedAt])
  @@map("gallery_albums")
}

model GalleryTranslation {
  id          String        @id @default(uuid()) @db.Uuid
  albumId     String        @map("album_id") @db.Uuid
  locale      String        @db.VarChar(2)
  title       String
  subtitle    String?
  description String?
  seoTitle    String?       @map("seo_title")
  seoDescription String?    @map("seo_description")
  album       GalleryAlbum  @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@unique([albumId, locale])
  @@map("gallery_translations")
}

model GalleryMedia {
  id                String       @id @default(uuid()) @db.Uuid
  albumId           String       @map("album_id") @db.Uuid
  mediaId           String?      @map("media_id") @db.Uuid
  mediaType         String       @map("media_type") @db.VarChar(20)
  category          String?
  videoProvider     String?      @map("video_provider")
  externalVideoUrl  String?      @map("external_video_url")
  title             String?
  caption           String?
  featured          Boolean      @default(false)
  sortOrder         Int          @default(0) @map("sort_order")
  album             GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  media             MediaAsset?  @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  @@index([albumId, sortOrder])
  @@map("gallery_media")
}

model ProductCategory {
  id         String    @id @default(uuid()) @db.Uuid
  key        String    @unique @db.VarChar(80)
  label      String
  sortOrder  Int       @default(0) @map("sort_order")
  products   Product[]

  @@map("product_categories")
}

model Product {
  id                 String             @id @default(uuid()) @db.Uuid
  slug               String             @unique @db.VarChar(160)
  categoryId         String?            @map("category_id") @db.Uuid
  status             ContentStatus      @default(DRAFT)
  basePriceMinor     Int                @map("base_price_minor")
  currency           String             @default("AUD") @db.Char(3)
  badge              String?
  featured           Boolean            @default(false)
  stockTracking      ProductStockTracking @default(NONE) @map("stock_tracking")
  publishedAt        DateTime?          @map("published_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  deletedAt          DateTime?          @map("deleted_at")
  category           ProductCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  translations       ProductTranslation[]
  images             ProductImage[]
  optionGroups       ProductOptionGroup[]
  variants           ProductVariant[]
  discountProducts   DiscountProduct[]
  orderItems         OrderItem[]

  @@index([status, categoryId])
  @@index([featured])
  @@map("products")
}

model ProductTranslation {
  id                    String  @id @default(uuid()) @db.Uuid
  productId             String  @map("product_id") @db.Uuid
  locale                String  @db.VarChar(2)
  title                 String
  excerpt               String?
  description           String?
  detailSectionsJson    Json?   @map("detail_sections_json")
  collectionHighlightsJson Json? @map("collection_highlights_json")
  seoTitle              String? @map("seo_title")
  seoDescription        String? @map("seo_description")
  product               Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  @@map("product_translations")
}

model ProductImage {
  id        String      @id @default(uuid()) @db.Uuid
  productId String      @map("product_id") @db.Uuid
  mediaId   String?     @map("media_id") @db.Uuid
  label     String?
  sortOrder Int         @default(0) @map("sort_order")
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  media     MediaAsset? @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  @@index([productId, sortOrder])
  @@map("product_images")
}

model ProductOptionGroup {
  id        String                @id @default(uuid()) @db.Uuid
  productId String                @map("product_id") @db.Uuid
  key       String                @db.VarChar(80)
  label     String
  sortOrder Int                   @default(0) @map("sort_order")
  product   Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  values    ProductOptionValue[]

  @@unique([productId, key])
  @@map("product_option_groups")
}

model ProductOptionValue {
  id            String                    @id @default(uuid()) @db.Uuid
  optionGroupId String                    @map("option_group_id") @db.Uuid
  valueKey      String                    @map("value_key") @db.VarChar(80)
  label         String
  colorHex      String?                   @map("color_hex")
  sortOrder     Int                       @default(0) @map("sort_order")
  optionGroup   ProductOptionGroup        @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)
  variantValues VariantOptionValue[]

  @@unique([optionGroupId, valueKey])
  @@map("product_option_values")
}

model ProductVariant {
  id            String                   @id @default(uuid()) @db.Uuid
  productId     String                   @map("product_id") @db.Uuid
  sku           String                   @unique @db.VarChar(100)
  priceMinor    Int                      @map("price_minor")
  currency      String                   @default("AUD") @db.Char(3)
  stockStatus   VariantStockStatus       @default(IN_STOCK) @map("stock_status")
  stockQuantity Int?                     @map("stock_quantity")
  enabled       Boolean                  @default(true)
  product       Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValues  VariantOptionValue[]
  orderItems    OrderItem[]

  @@index([productId, enabled])
  @@map("product_variants")
}

model VariantOptionValue {
  variantId     String             @map("variant_id") @db.Uuid
  optionValueId String             @map("option_value_id") @db.Uuid
  variant       ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue   ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionValueId])
  @@map("variant_option_values")
}

model Discount {
  id                    String             @id @default(uuid()) @db.Uuid
  code                  String             @unique @db.VarChar(80)
  type                  DiscountType
  valueMinor            Int?               @map("value_minor")
  percentage            Decimal?           @db.Decimal(5, 2)
  currency              String?            @db.Char(3)
  minimumSubtotalMinor  Int?               @map("minimum_subtotal_minor")
  usageLimit            Int?               @map("usage_limit")
  usageCount            Int                @default(0) @map("usage_count")
  startsAt              DateTime?          @map("starts_at")
  endsAt                DateTime?          @map("ends_at")
  active                Boolean            @default(true)
  products              DiscountProduct[]
  orders               Order[]

  @@index([active, startsAt, endsAt])
  @@map("discounts")
}

model DiscountProduct {
  discountId String   @map("discount_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([discountId, productId])
  @@map("discount_products")
}

model ShippingZone {
  id        String         @id @default(uuid()) @db.Uuid
  name      String
  countriesJson Json       @map("countries_json")
  active    Boolean        @default(true)
  rates     ShippingRate[]

  @@map("shipping_zones")
}

model ShippingRate {
  id                    String       @id @default(uuid()) @db.Uuid
  zoneId                String       @map("zone_id") @db.Uuid
  name                  String
  priceMinor            Int          @map("price_minor")
  currency              String       @default("AUD") @db.Char(3)
  minimumSubtotalMinor  Int?         @map("minimum_subtotal_minor")
  active                Boolean      @default(true)
  zone                  ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([zoneId, active])
  @@map("shipping_rates")
}

model Order {
  id              String            @id @default(uuid()) @db.Uuid
  orderNumber     String            @unique @map("order_number") @db.VarChar(40)
  paymentStatus   PaymentStatus     @default(PENDING) @map("payment_status")
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED) @map("fulfillment_status")
  currency        String            @default("AUD") @db.Char(3)
  customerEmail   String?           @map("customer_email") @db.VarChar(320)
  clientReference String?           @unique @map("client_reference") @db.VarChar(80)
  subtotalMinor   Int               @map("subtotal_minor")
  discountMinor   Int               @default(0) @map("discount_minor")
  shippingMinor   Int               @default(0) @map("shipping_minor")
  taxMinor        Int               @default(0) @map("tax_minor")
  totalMinor      Int               @map("total_minor")
  discountId      String?           @map("discount_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  discount        Discount?         @relation(fields: [discountId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  checkoutSessions CheckoutSession[]
  payments        Payment[]
  notes           OrderNote[]

  @@index([paymentStatus, createdAt])
  @@index([fulfillmentStatus, createdAt])
  @@map("orders")
}

model OrderItem {
  id                String          @id @default(uuid()) @db.Uuid
  orderId           String          @map("order_id") @db.Uuid
  productId         String?         @map("product_id") @db.Uuid
  variantId         String?         @map("variant_id") @db.Uuid
  titleSnapshot     String          @map("title_snapshot")
  variantSnapshot   String?         @map("variant_snapshot")
  imageUrlSnapshot  String?         @map("image_url_snapshot")
  unitPriceMinor    Int             @map("unit_price_minor")
  quantity          Int
  lineTotalMinor    Int             @map("line_total_minor")
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

model CheckoutSession {
  id                String                @id @default(uuid()) @db.Uuid
  orderId           String                @map("order_id") @db.Uuid
  provider          String
  providerSessionId String                @unique @map("provider_session_id")
  status            CheckoutSessionStatus @default(OPEN)
  expiresAt         DateTime?             @map("expires_at")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  order             Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, status])
  @@map("checkout_sessions")
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  orderId           String        @map("order_id") @db.Uuid
  provider          String
  providerPaymentId String?       @map("provider_payment_id")
  status            PaymentStatus
  amountMinor       Int           @map("amount_minor")
  currency          String        @db.Char(3)
  paidAt            DateTime?     @map("paid_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([provider, providerPaymentId])
  @@map("payments")
}

model OrderNote {
  id           String    @id @default(uuid()) @db.Uuid
  orderId      String    @map("order_id") @db.Uuid
  authorUserId String    @map("author_user_id") @db.Uuid
  note         String
  createdAt    DateTime  @default(now()) @map("created_at")
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author       AdminUser @relation(fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@map("order_notes")
}

model WebhookEvent {
  id              String        @id @default(uuid()) @db.Uuid
  provider        String
  providerEventId String        @map("provider_event_id")
  eventType       String        @map("event_type")
  payloadHash     String        @map("payload_hash")
  status          WebhookStatus @default(RECEIVED)
  processedAt     DateTime?     @map("processed_at")
  createdAt       DateTime      @default(now()) @map("created_at")

  @@unique([provider, providerEventId])
  @@map("webhook_events")
}

model FaqCategory {
  id        String     @id @default(uuid()) @db.Uuid
  key       String     @unique @db.VarChar(80)
  icon      String?
  sortOrder Int        @default(0) @map("sort_order")
  items     FaqItem[]

  @@map("faq_categories")
}

model FaqItem {
  id         String           @id @default(uuid()) @db.Uuid
  categoryId String           @map("category_id") @db.Uuid
  eventId    String?          @map("event_id") @db.Uuid
  published  Boolean          @default(false)
  sortOrder  Int              @default(0) @map("sort_order")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")
  category   FaqCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  event      Event?           @relation(fields: [eventId], references: [id], onDelete: SetNull)
  translations FaqTranslation[]

  @@index([published, sortOrder])
  @@map("faq_items")
}

model FaqTranslation {
  id        String   @id @default(uuid()) @db.Uuid
  faqId     String   @map("faq_id") @db.Uuid
  locale    String   @db.VarChar(2)
  question  String
  answer    String
  keywordsJson Json? @map("keywords_json")
  faq       FaqItem  @relation(fields: [faqId], references: [id], onDelete: Cascade)

  @@unique([faqId, locale])
  @@map("faq_translations")
}

model LegalDocument {
  id            String             @id @default(uuid()) @db.Uuid
  type          String             @unique @db.VarChar(40)
  status        LegalStatus        @default(DRAFT)
  version       String             @default("1.0")
  effectiveAt   DateTime?          @map("effective_at")
  publishedAt   DateTime?          @map("published_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  translations  LegalTranslation[]

  @@map("legal_documents")
}

model LegalTranslation {
  id              String         @id @default(uuid()) @db.Uuid
  documentId      String         @map("document_id") @db.Uuid
  locale          String         @db.VarChar(2)
  title           String
  intro           String?
  sectionsJson    Json           @map("sections_json")
  seoTitle        String?        @map("seo_title")
  seoDescription  String?        @map("seo_description")
  document        LegalDocument  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, locale])
  @@map("legal_translations")
}

model Partner {
  id           String              @id @default(uuid()) @db.Uuid
  slug         String              @unique @db.VarChar(120)
  type         String              @db.VarChar(80)
  logoMediaId  String?             @map("logo_media_id") @db.Uuid
  imageMediaId String?             @map("image_media_id") @db.Uuid
  websiteUrl   String?             @map("website_url")
  featured     Boolean             @default(false)
  status       ContentStatus       @default(DRAFT)
  sortOrder    Int                 @default(0) @map("sort_order")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  logoMedia    MediaAsset?         @relation("partnerLogoMedia", fields: [logoMediaId], references: [id], onDelete: SetNull)
  imageMedia   MediaAsset?         @relation("partnerImageMedia", fields: [imageMediaId], references: [id], onDelete: SetNull)
  translations PartnerTranslation[]

  @@index([status, sortOrder])
  @@map("partners")
}

model PartnerTranslation {
  id          String  @id @default(uuid()) @db.Uuid
  partnerId   String  @map("partner_id") @db.Uuid
  locale      String  @db.VarChar(2)
  name        String
  tagline     String?
  description String?
  partner     Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([partnerId, locale])
  @@map("partner_translations")
}

model ContactMessage {
  id                 String             @id @default(uuid()) @db.Uuid
  fullName           String             @map("full_name")
  email              String             @db.VarChar(320)
  phone              String?
  enquiryType        String?            @map("enquiry_type")
  message            String
  status             ContactStatus      @default(NEW)
  notificationStatus NotificationStatus @default(PENDING) @map("notification_status")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("contact_messages")
}

model NewsletterSubscriber {
  id                 String             @id @default(uuid()) @db.Uuid
  email              String             @unique @db.VarChar(320)
  locale             String             @default("en") @db.VarChar(2)
  status             SubscriberStatus   @default(SUBSCRIBED)
  source             String?
  provider           String?
  providerSyncStatus ProviderSyncStatus @default(PENDING) @map("provider_sync_status")
  subscribedAt       DateTime           @default(now()) @map("subscribed_at")
  unsubscribedAt     DateTime?          @map("unsubscribed_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  @@map("newsletter_subscribers")
}

model IntegrationSetting {
  id            String            @id @default(uuid()) @db.Uuid
  provider      String            @unique @db.VarChar(60)
  status        IntegrationStatus @default(NOT_CONFIGURED)
  publicConfig  Json?             @map("public_config")
  lastCheckedAt DateTime?         @map("last_checked_at")
  lastErrorCode String?           @map("last_error_code")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  @@map("integration_settings")
}
